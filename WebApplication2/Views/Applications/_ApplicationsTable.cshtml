@model IEnumerable<AcademyProfi.Models.Application>

@Html.AntiForgeryToken()

<table class="table table-striped">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Email</th>
            <th>Курс</th>
            <th>Статус</th>
            <th>Создана</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr id="row-@item.Id">
                <td>@item.StudentName</td>
                <td>@item.Email</td>
                <td>@item.Course?.Title</td>
                <td>
                    <select class="form-control status-dropdown" data-id="@item.Id">
                        @foreach (var s in (IEnumerable<AcademyProfi.Models.StatusDict>)ViewBag.StatusListItems ?? new List<AcademyProfi.Models.StatusDict>())
                        {
                            <option value="@s.Id" selected="@(s.Id == item.StatusId)">@s.DisplayName</option>
                        }
                    </select>
                </td>
                <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Ред.</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Детали</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>